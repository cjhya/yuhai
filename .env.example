## 默认开启纯前端演示：无需业务后端或算法服务即可走通四条核心流程。
## 接入真实服务时改为 false，并配置下方两个地址。
VUE_APP_DEMO_MODE=true
VUE_APP_BUSINESS_API_BASE_URL=http://127.0.0.1:8083
VUE_APP_ALGORITHM_API_BASE_URL=http://127.0.0.1:5000
VUE_APP_BUSINESS_API_TIMEOUT=5000
VUE_APP_ALGORITHM_API_TIMEOUT=120000
VUE_APP_TRAIN_API_TIMEOUT=600000
# legacy 保持现有 GET /train；后端提供 /training-jobs 协议后切换为 async
VUE_APP_TRAINING_JOB_MODE=legacy
VUE_APP_DATASET_MAX_FILE_SIZE_MB=20
VUE_APP_DATASET_MAX_ROWS=100000
VUE_APP_DATASET_MAX_CELLS=2000000
VUE_APP_DATASET_PREVIEW_ROWS=200
# 后端 CORS 允许 X-Request-ID 后再开启
VUE_APP_SEND_REQUEST_ID=false
